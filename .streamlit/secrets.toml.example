# Copy to secrets.toml ONLY for local use if a named connection is unavailable.
# Never commit secrets.toml. Prefer your existing secured connection profile.
[snowflake]
account = "YOUR_ORG-YOUR_ACCOUNT"
user = "YOUR_USER"
authenticator = "externalbrowser"
role = "YOUR_DEMO_ROLE"
warehouse = "YOUR_EXISTING_WAREHOUSE"
